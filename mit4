import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

def custom_function(x):
return np.sin(x) * np.cos(x / 2 + np.sin(x))

x_values = np.linspace(0, 10, 100)
y_values = custom_function(x_values)

input_data = x_values.reshape(-1, 1)
y_values = y_values.ravel()

train_data, test_data, train_target, test_target =
train_test_split(input_data, y_values, test_size=0.4)

scaler = StandardScaler()
train_data = scaler.fit_transform(train_data)
test_data = scaler.transform(test_data)

train_data_tensor = torch.FloatTensor(train_data)
train_target_tensor = torch.FloatTensor(train_target)
test_data_tensor = torch.FloatTensor(test_data)
test_target_tensor = torch.FloatTensor(test_target)

class FeedForwardNetwork(nn.Module):
def __init__(self, input_size, hidden_layers):
super(FeedForwardNetwork, self).__init__()
layers = []
prev_size = input_size
for hidden_size in hidden_layers:

layers.append(nn.Linear(prev_size, hidden_size))
layers.append(nn.ReLU())
prev_size = hidden_size
layers.append(nn.Linear(prev_size, 1))
self.network = nn.Sequential(*layers)

def forward(self, x):
return self.network(x)

class CascadeNetwork(nn.Module):
def __init__(self, input_size, hidden_layers):
super(CascadeNetwork, self).__init__()
self.hidden_layers = nn.ModuleList()
self.input_size = input_size
prev_size = input_size
for hidden_size in hidden_layers:
self.hidden_layers.append(nn.Linear(prev_size + input_size,
hidden_size))
prev_size = hidden_size
self.output = nn.Linear(prev_size + input_size, 1)

def forward(self, x):
out = x
for layer in self.hidden_layers:
out = torch.cat([x, out], dim=1)
out = torch.relu(layer(out))
out = torch.cat([x, out], dim=1)
return self.output(out)

class ElmanNetwork(nn.Module):
def __init__(self, input_size, hidden_sizes, output_size=1):
super(ElmanNetwork, self).__init__()
self.hidden_sizes = hidden_sizes
self.input_to_hidden = nn.ModuleList(
[nn.Linear(input_size + hidden_size, hidden_size) for
hidden_size in hidden_sizes]
)
self.hidden_to_output = nn.Linear(hidden_sizes[-1], output_size)
self.tanh = nn.Tanh()

def forward(self, x, hidden):
combined = torch.cat((x, hidden[0]), 1)
hidden_next = []
for i, input_to_hidden_layer in enumerate(self.input_to_hidden):
hidden_i = self.tanh(input_to_hidden_layer(combined))
combined = torch.cat((x, hidden_i), 1)
hidden_next.append(hidden_i)
output = self.hidden_to_output(hidden_next[-1])
return output, hidden_next

def init_hidden(self, batch_size):
return [torch.zeros(batch_size, hidden_size) for hidden_size in
self.hidden_sizes]

def train_model(model, epochs=500, learning_rate=0.05):
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=learning_rate)
loss_curve = []

def initialize_weights(m):

if isinstance(m, nn.Linear):
nn.init.xavier_uniform_(m.weight)
model.apply(initialize_weights)

for epoch in range(epochs):
model.train()
optimizer.zero_grad()
if isinstance(model, ElmanNetwork):
hidden_state = model.init_hidden(train_data_tensor.size(0))
output, hidden_state = model(train_data_tensor, hidden_state)
else:
output = model(train_data_tensor)
loss = criterion(output, train_target_tensor.unsqueeze(1))
loss.backward()
optimizer.step()
loss_curve.append(loss.item())
model.eval()
with torch.no_grad():
if isinstance(model, ElmanNetwork):
hidden_state = model.init_hidden(test_data_tensor.size(0))
predictions, hidden_state = model(test_data_tensor,
hidden_state)
else:
predictions = model(test_data_tensor)
full_predictions = model(torch.FloatTensor(input_data)) if not
isinstance(model, ElmanNetwork) else \
model(torch.FloatTensor(input_data),
model.init_hidden(input_data.shape[0]))[0]
full_mse = mean_squared_error(y_values,
full_predictions.detach().numpy().squeeze())
return predictions, full_mse, loss_curve
while True:

print("""
Choose:
1: Feed Forward (1l, 10n)
2: Feed Forward (1l, 20n)
3: Cascade Forward (1l, 20n)
4: Cascade Forward (2l/10n)
5: Elman (1l, 15n)
6: Elman (3l/5n)
7: Exit
Number: """)
user_choice = input().strip()
if user_choice == '1':
hidden_layers = [10]
model = FeedForwardNetwork(input_size=1,
hidden_layers=hidden_layers)
elif user_choice == '2':
hidden_layers = [20]
model = FeedForwardNetwork(input_size=1,
hidden_layers=hidden_layers)
elif user_choice == '3':
hidden_layers = [20]
model = CascadeNetwork(input_size=1, hidden_layers=hidden_layers)
elif user_choice == '4':
hidden_layers = [10, 10]
model = CascadeNetwork(input_size=1, hidden_layers=hidden_layers)
elif user_choice == '5':
model = ElmanNetwork(input_size=1, hidden_sizes=[15])
elif user_choice == '6':
model = ElmanNetwork(input_size=1, hidden_sizes=[5, 5, 5])
elif user_choice == '7':
print("Exit.")
break

else:
print("Wrong")
continue
predictions, mse, loss_curve = train_model(model, epochs=500,
learning_rate=0.05)
print(f"\nMSE: {mse:.4f}")

# Visualization
plt.figure(figsize=(12, 5))
plt.subplot(2, 2, 1)
plt.plot(x_values, y_values, label='True Function')
plt.title('y = sin(x) * cos(x/2 + sin(x))')
plt.xlabel('x')
plt.ylabel('y')
plt.grid()
plt.subplot(2, 2, 3)
plt.plot(test_data_tensor.numpy().flatten(),
predictions.detach().numpy().flatten(), 'o', label='Predictions')
plt.title('Neural Network Predictions')
plt.xlabel('x')
plt.ylabel('y')
plt.grid()
plt.subplot(2, 2, 2)
plt.plot(loss_curve, color='green')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.title('Loss Curve')
plt.grid()
plt.tight_layout()
plt.show()
